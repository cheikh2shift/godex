# =============================================================================
# DYNO Docker Environment Configuration
# =============================================================================

# Enable DYNO mode
DYNO_MODE=true
DYNO_TRACKING_ENABLED=true

# Mock HTTP responses (simulate tool calling)
DYNO_MOCK_HTTP=true
DYNO_MOCK_HTTP_STATUS=200
DYNO_MOCK_HTTP_BODY='{"status": "mocked", "data": {"result": "success"}}'
DYNO_MOCK_HTTP_HEADERS='Content-Type: application/json'
DYNO_MOCK_PORT=8888

# Mock file operations
DYNO_MOCK_FILEOPS=true
DYNO_MOCK_FILE_CONTENT="[MOCKED FILE CONTENT]"
DYNO_MOCK_FILE_EXISTS=true
DYNO_MOCK_DIR_CONTENT="mock_file1.txt,mock_file2.txt,mock_dir/"

# Mock command executions
DYNO_MOCK_COMMANDS=true
DYNO_MOCK_CMD_EXITCODE=0
DYNO_MOCK_CMD_STDOUT="[MOCKED COMMAND OUTPUT]"
DYNO_MOCK_CMD_STDERR=""

# Mock syscalls
DYNO_MOCK_SYSCALLS=true
DYNO_MOCK_SYSCALL_RESULT=0

# Tracking log paths
DYNO_LOG_DIR=/dyno/logs
DYNO_HTTP_LOG=$DYNO_LOG_DIR/http_tracking.log
DYNO_FILE_LOG=$DYNO_LOG_DIR/file_tracking.log
DYNO_CMD_LOG=$DYNO_LOG_DIR/cmd_tracking.log
DYNO_SYSCALL_LOG=$DYNO_LOG_DIR/syscall_tracking.log

# Network isolation
DYNO_NETWORK_ISOLATED=true
DYNO_ALLOWED_HOSTS="localhost,127.0.0.1"

# Filesystem isolation
DYNO_FS_ISOLATED=true
DYNO_ALLOWED_PATHS="/tmp,/dyno"

# Workspace
DYNO_WORKSPACE=/dyno/workspace
